<div id="billView" class="app-view bill-view" dir="rtl">
    <div class="bill-top no-print">
    <div class="brand-bar"><div class="brand-id"><span class="brand-logo"><img src="icon.jpg" alt=""><i class="sync-dot" data-state="ok"></i></span><span class="brand-name">صيدلية الديوان</span></div><div class="brand-actions"><button type="button" class="small-icon-btn" onclick="showView('home')" aria-label="الرئيسية">🏠</button><button type="button" class="small-icon-btn" onclick="toggleTheme()" aria-label="الوضع الداكن">🌓</button></div></div>
<div class="page-title">🧾 الفواتير</div>
    </div>
    <div class="bill-tabs no-print" id="billTabs">
        <button type="button" data-tab="new" class="active" onclick="billTab('new')">➕ فاتورة جديدة</button>
        <button type="button" data-tab="issued" onclick="billTab('issued')">📚 الصادرة</button>
        <button type="button" data-tab="debt" onclick="billTab('debt')">💳 الآجل</button>
        <button type="button" data-tab="reports" onclick="billTab('reports')">📊 التقارير</button>
        <button type="button" data-tab="po" onclick="billTab('po')">🛒 طلب شراء</button>
        <button type="button" data-tab="settings" onclick="billTab('settings')">⚙️ الإعدادات</button>
    </div>

    <div class="bill-scroll">
        <!-- ===== فاتورة جديدة ===== -->
        <section class="bill-pane active print-active" id="billPane-new">
            <div class="bill-actions no-print">
                <button type="button" class="bill-tb-btn" onclick="newInvoice()">＋ جديدة</button>
                <button type="button" class="bill-tb-btn" id="billDraftPrintBtn" onclick="printInvoice(true)">🖨️ طباعة بدون إصدار</button>
                <button type="button" class="bill-tb-btn bill-danger" id="billCancelBtn" onclick="cancelInvoice()" style="display:none;">✖ إلغاء الفاتورة</button>
                <button type="button" class="bill-tb-btn bill-tb-primary" id="billIssueBtn" onclick="issueInvoice()">✅ إصدار وطباعة</button>
            </div>
            <div class="bill-sheet" id="billSheet">
                <div class="bill-letterhead">
                    <img src="icon.jpg" alt="" class="bill-logo">
                    <div class="bill-ph">
                        <div class="bill-ph-name">صيدلية الديوان</div>
                        <div class="bill-ph-line" id="billPhLine1"></div>
                        <div class="bill-ph-line" id="billPhLine2"></div>
                    </div>
                    <div class="bill-title-box">
                        <div class="bill-title">فاتورة بيع</div>
                        <label class="bill-no">رقم: <input id="billNo" dir="ltr" oninput="billChanged()"></label>
                    </div>
                </div>

                <div class="bill-meta">
                    <label class="bill-field"><span>اسم الزبون:</span><input id="billCustomer" oninput="billChanged()"></label>
                    <label class="bill-field"><span>اسم الطبيب المعالج:</span><input id="billDoctor" oninput="billChanged()"></label>
                    <label class="bill-field bill-date"><span>التاريخ:</span>
                        <input type="date" id="billDate" class="bill-date-input" oninput="billChanged()">
                        <span class="bill-date-txt" id="billDateTxt"></span>
                    </label>
                </div>

                <table class="bill-table">
                    <thead><tr><th class="c-n">#</th><th class="c-name">اسم المادة</th><th class="c-qty">العدد</th><th class="c-price">السعر</th><th class="c-sum">المجموع</th><th class="c-del no-print"></th></tr></thead>
                    <tbody id="billRows"></tbody>
                </table>

                <div class="bill-issued no-print" id="billIssuedNote" style="display:none;"></div>
                <div class="bill-add no-print">
                    <div class="bill-search-wrap">
                        <input type="search" id="billSearch" autocomplete="off" placeholder="🔍 ابحث بالاسم أو امسح الباركود..." oninput="billSearchInput()" onkeydown="if(event.key==='Enter'){billSearchEnter();}">
                        <div class="bill-results" id="billResults" style="display:none;"></div>
                    </div>
                    <button type="button" class="bill-tb-btn bill-scan" onclick="billScan()" aria-label="مسح باركود">▦ باركود</button>
                    <button type="button" class="bill-tb-btn" onclick="billAddBlank()">＋ سطر</button>
                </div>

                <div class="bill-bottom">
                    <div class="bill-totals">
                        <div class="bill-trow"><span>مجموع المواد</span><b id="billSub">0</b></div>
                        <div class="bill-trow bill-disc has-pv" id="billDiscRow"><span>الخصم</span><input type="number" min="0" inputmode="decimal" id="billDiscount" oninput="billChanged()" placeholder="0"><span class="bill-pv" id="billDiscTxt"></span></div>
                        <div class="bill-trow bill-grand"><span>المبلغ الكلي</span><b id="billTotal">0</b></div>
                        <div class="bill-trow bill-paid has-pv" id="billPaidRow"><span>المبلغ المدفوع</span><input type="number" min="0" inputmode="decimal" id="billPaid" oninput="billChanged()" placeholder="—"><span class="bill-pv" id="billPaidTxt"></span></div>
                        <div class="bill-trow bill-rem" id="billRemRow"><span>المتبقي (آجل)</span><b id="billRem">0</b></div>
                    </div>
                </div>
                <div class="bill-words" id="billWords"></div>
                <div class="bill-opts no-print">
                    <label class="bill-check"><input type="checkbox" id="billDeduct" checked onchange="billChanged()"> خصم الكميات من المخزن عند الإصدار</label>
                </div>

                <div class="bill-parties">
                    <label class="bill-field bill-to"><span>إلى السيد / الشركة:</span><input id="billTo" placeholder="اكتب اسم الشركة" oninput="billChanged()"></label>
                </div>
                <label class="bill-field bill-notes"><span>ملاحظات:</span><textarea id="billNotes" rows="1" oninput="billChanged(); autoGrow(this)"></textarea></label>

                <div class="bill-signs">
                    <div class="bill-sign"><div class="bill-sign-box" id="billSigBox"></div><div class="bill-sign-label">توقيع الصيدلاني</div></div>
                    <div class="bill-sign"><div class="bill-sign-box" id="billStampBox"></div><div class="bill-sign-label">ختم الصيدلية</div></div>
                </div>
                <div class="bill-ret" id="billRetTxt"></div>
                <div class="bill-foot" id="billFootTxt"></div>
            </div>
        </section>

        <!-- ===== الفواتير الصادرة ===== -->
        <section class="bill-pane" id="billPane-issued">
            <div class="bill-panel no-print">
                <input type="search" class="bill-list-search" id="billListSearch" placeholder="🔍 ابحث برقم الفاتورة أو الاسم..." oninput="renderIssuedList()">
                <div class="bill-list" id="billList"></div>
            </div>
        </section>

        <!-- ===== الآجل ===== -->
        <section class="bill-pane" id="billPane-debt">
            <div class="bill-panel no-print">
                <div class="bill-sum-card" id="debtSummary"></div>
                <div class="bill-list" id="debtList"></div>
            </div>
        </section>

        <!-- ===== التقارير ===== -->
        <section class="bill-pane" id="billPane-reports">
            <div class="bill-panel no-print">
                <div class="bill-range" id="reportRange">
                    <button type="button" data-r="today" class="active" onclick="setReportRange('today')">اليوم</button>
                    <button type="button" data-r="week" onclick="setReportRange('week')">7 أيام</button>
                    <button type="button" data-r="month" onclick="setReportRange('month')">هذا الشهر</button>
                    <button type="button" data-r="all" onclick="setReportRange('all')">الكل</button>
                </div>
                <div id="reportBody"></div>
            </div>
        </section>

        <!-- ===== طلب شراء ===== -->
        <section class="bill-pane" id="billPane-po">
            <div class="bill-actions no-print">
                <button type="button" class="bill-tb-btn" onclick="poSelectAll(true)">تحديد الكل</button>
                <button type="button" class="bill-tb-btn" onclick="poShareWhatsApp()">💬 واتساب</button>
                <button type="button" class="bill-tb-btn bill-tb-primary" onclick="poPrint()">🖨️ طباعة</button>
            </div>
            <div class="bill-sheet" id="poSheet">
                <div class="bill-letterhead">
                    <img src="icon.jpg" alt="" class="bill-logo">
                    <div class="bill-ph"><div class="bill-ph-name">صيدلية الديوان</div><div class="bill-ph-line" id="poPhLine"></div></div>
                    <div class="bill-title-box"><div class="bill-title">طلب شراء</div></div>
                </div>
                <div class="bill-meta">
                    <label class="bill-field bill-to"><span>إلى المذخر / الشركة:</span><input id="poSupplier" placeholder="اسم المذخر" oninput="poSaveSupplier()"></label>
                    <label class="bill-field bill-date"><span>التاريخ:</span><span class="bill-date-txt" id="poDateTxt" style="display:inline;"></span></label>
                </div>
                <table class="bill-table">
                    <thead><tr><th class="c-n no-print">✓</th><th class="c-name">المادة</th><th class="c-qty">المتوفر</th><th class="c-qty">المطلوب</th></tr></thead>
                    <tbody id="poRows"></tbody>
                </table>
                <div class="bill-foot" id="poFoot"></div>
            </div>
        </section>

        <!-- ===== الإعدادات ===== -->
        <section class="bill-pane" id="billPane-settings">
            <div class="bill-settings no-print">
                <div class="bill-set-title">⚙️ بيانات الصيدلية على الفاتورة <small>(تُحفظ على هذا الجهاز)</small></div>
                <label class="bill-field"><span>العنوان:</span><input id="setAddr" oninput="billSaveMeta()" placeholder="مثال: البصرة - ..."></label>
                <label class="bill-field"><span>الهاتف:</span><input id="setPhone" dir="ltr" oninput="billSaveMeta()"></label>
                <label class="bill-field"><span>الصيدلاني / رقم الإجازة:</span><input id="setLic" oninput="billSaveMeta()" placeholder="اختياري"></label>
                <label class="bill-field"><span>سياسة الإرجاع:</span><input id="setRet" oninput="billSaveMeta()" placeholder="مثال: الأدوية المباعة لا تُرد ولا تُستبدل بعد الاستلام"></label>
                <label class="bill-field"><span>سطر أسفل الفاتورة:</span><input id="setFoot" oninput="billSaveMeta()" placeholder="مثال: شكراً لثقتكم"></label>
                <div class="bill-set-imgs">
                    <label class="bill-tb-btn">🖋️ صورة التوقيع<input type="file" accept="image/*" hidden onchange="billPickImage('sig', this)"></label>
                    <label class="bill-tb-btn">🔵 صورة الختم<input type="file" accept="image/*" hidden onchange="billPickImage('stamp', this)"></label>
                    <button type="button" class="bill-tb-btn" onclick="billClearImages()">إزالة الصورتين</button>
                </div>
                <div class="bill-set-hint">إن تركت الصورتين فارغتين يبقى مكان التوقيع والختم فارغاً لتوقّع وتختم بيدك بعد الطباعة.</div>
            </div>
        </section>
    </div>
</div>
