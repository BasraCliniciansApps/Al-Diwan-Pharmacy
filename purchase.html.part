<div id="purchView" class="app-view bill-view" dir="rtl">
    <div class="bill-top no-print">
    <div class="brand-bar"><div class="brand-id"><span class="brand-logo"><img src="icon.jpg" alt=""><i class="sync-dot" data-state="ok"></i></span><span class="brand-name">صيدلية الديوان</span></div><div class="brand-actions"><button type="button" class="small-icon-btn" onclick="showView('home')" aria-label="الرئيسية">🏠</button><button type="button" class="small-icon-btn" onclick="toggleTheme()" aria-label="الوضع الداكن">🌓</button></div></div>
<div class="page-title">📥 الوارد من المذاخر</div>
    </div>
    <div class="bill-tabs no-print" id="puTabs">
        <button type="button" data-tab="new" class="active" onclick="puTab('new')">➕ وارد جديد</button>
        <button type="button" data-tab="log" onclick="puTab('log')">📚 السجل</button>
        <button type="button" data-tab="debt" onclick="puTab('debt')">💳 مستحقات المذاخر</button>
        <button type="button" data-tab="hub" onclick="puTab('hub')" id="puTabHub">📚 السجلات</button>
        <button type="button" data-tab="sup" onclick="puTab('sup')">🏭 المذاخر والأسعار</button>
    </div>

    <div class="bill-scroll">
        <!-- ===== وارد جديد ===== -->
        <section class="pu-pane active" id="puPane-new">
            <div class="pu-card">
                <div class="pu-form">
                    <label><span>المذخر المجهز</span><input id="puSupplier" list="puSupList" autocomplete="off" placeholder="اسم المذخر" oninput="puChanged()"><datalist id="puSupList"></datalist></label>
                    <label><span>رقم فاتورة المذخر</span><input id="puNo" dir="ltr" autocomplete="off" oninput="puChanged()"></label>
                    <label><span>تاريخ فاتورة المذخر</span><input type="date" id="puDate" oninput="puChanged()"></label>
                    <label class="pu-chk"><input type="checkbox" id="puStmt" onchange="puChanged()"><span>✓ استلمتُ كشف المذخر لهذه القائمة</span></label>
                    <label class="pu-chk"><input type="checkbox" id="puUseEntry" onchange="puChanged()"><span>اعتماد تاريخ الإدخال (اليوم) لتحديد شهرها بدل تاريخ القائمة</span></label>
                </div>
            </div>
            <div class="bill-add">
                <div class="bill-search-wrap">
                    <input type="search" id="puSearch" autocomplete="off" placeholder="🔍 ابحث عن الدواء أو امسح الباركود..." oninput="puSearchInput()" onkeydown="if(event.key==='Enter'){puSearchEnter();}">
                    <div class="bill-results" id="puResults" style="display:none;"></div>
                </div>
                <button type="button" class="bill-tb-btn bill-scan" onclick="puScan()" aria-label="مسح باركود">▦ باركود</button>
            </div>
            <div class="pu-hint" id="puPendingHint" style="display:none;"></div>
            <div class="pu-count" id="puCount"></div>
            <div class="pu-editbar" id="puEditBar" style="display:none;"><span>✏️ أنت تعدّل فاتورة مسجّلة — سيُصحَّح المخزن تلقائياً بالفرق.</span><button type="button" onclick="puCancelEdit()">إلغاء التعديل</button></div>
            <div class="pu-viewbar no-print" id="puViewBar"><button type="button" data-v="table" onclick="puSetView('table')">⚡ جدول سريع</button><button type="button" data-v="cards" onclick="puSetView('cards')">🗂️ بطاقات</button></div>
            <div id="puFast" class="pt-wrap">
                <div class="pt-add">
                    <div class="pt-namewrap"><input id="ptName" placeholder="اسم المادة..." autocomplete="off" oninput="ptNameInput()" onkeydown="ptKey(event,'name')"><div id="ptRes" class="bill-results" style="display:none;"></div></div>
                    <input id="ptBrand" placeholder="الشركة (للمادة الجديدة)" autocomplete="off" style="display:none" onkeydown="ptKey(event,'brand')">
                    <div class="pt-in">
                        <label><span>عدد</span><input id="ptQty" type="number" min="1" inputmode="numeric" onkeydown="ptKey(event,'qty')"></label>
                        <label><span>بونص</span><input id="ptBonus" type="number" min="0" inputmode="numeric" placeholder="0" onkeydown="ptKey(event,'bonus')"></label>
                        <label><span>سعر الشراء</span><input id="ptCost" type="number" min="0" inputmode="decimal" onkeydown="ptKey(event,'cost')"></label>
                        <label><span>انتهاء</span><input id="ptExp" type="text" inputmode="numeric" dir="ltr" placeholder="MMYY" onkeydown="ptKey(event,'exp')"></label>
                    </div>
                    <button type="button" class="pt-addbtn" onclick="ptCommit()">＋ أضف للقائمة</button>
                </div>
                <div id="puTable"></div>
            </div>
            <div id="puItems"></div>
            <div class="pu-card pu-totals">
                <div class="pu-trow"><span>مجموع الفاتورة</span><b id="puTotal">0</b></div>
                <label class="pu-trow"><span>مبلغ الاسترجاع</span><input type="number" min="0" inputmode="decimal" id="puReturn" placeholder="0" oninput="puChanged()"></label>
                <div class="pu-trow pu-net"><span>الصافي بعد الاسترجاع</span><b id="puNet">0</b></div>
                <label class="pu-trow"><span>المبلغ المدفوع الآن</span><input type="number" min="0" inputmode="decimal" id="puPaid" placeholder="0" oninput="puChanged()"></label>
                <div class="pu-trow pu-rem"><span>المتبقي للمذخر (دين)</span><b id="puRem">0</b></div>
            </div>
            <label class="pu-notes"><span>ملاحظات</span><textarea id="puNotes" rows="2" oninput="puChanged()"></textarea></label>
            <div class="bill-actions">
                <button type="button" class="bill-tb-btn" onclick="puNew()">＋ جديد</button>
                <button type="button" class="bill-tb-btn bill-tb-primary" id="puSaveBtn" onclick="puSave()">✅ حفظ الوارد وإضافته للمخزن</button>
            </div>
        </section>

        <!-- ===== السجل ===== -->
        <section class="pu-pane" id="puPane-log">
            <div class="bill-panel">
                <div class="pu-logbar"><select id="puLogMonth" onchange="renderPuLog()" aria-label="الشهر"></select>
                <input type="search" class="bill-list-search" id="puLogSearch" placeholder="🔍 ابحث باسم المذخر أو رقم الفاتورة..." oninput="renderPuLog()"></div>
                <div class="pu-selbar no-print" id="puSelBar"></div>
                <div class="bill-list" id="puLogList"></div>
            </div>
        </section>
        <section class="pu-pane" id="puPane-sel"><div class="bill-sheet" id="puSelSheet"></div></section>

        <!-- ===== المستحقات ===== -->
        <section class="pu-pane" id="puPane-debt">
            <div class="bill-panel">
                <div class="bill-sum-card" id="puDebtSummary"></div>
                <div id="puDebtList"></div>
            </div>
        </section>

        <!-- ===== سجل الطلبيات (شهري/سنوي) ===== -->
        <section class="pu-pane" id="puPane-month">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>الفترة</span><select id="puPType" onchange="puInitMonth(true)"><option value="month">شهر</option><option value="year">سنة كاملة</option></select></label>
                <label class="pu-mfield" id="puMonthWrap"><span>الشهر</span><input type="month" id="puMonth" oninput="renderPuMonth()"></label>
                <label class="pu-mfield" id="puYearWrap" style="display:none"><span>السنة</span><input type="number" id="puYear" min="2000" max="2100" oninput="renderPuMonth()"></label>
                <label class="pu-mfield"><span>المذخر</span><select id="puMonthSup" onchange="renderPuMonth()"></select></label>
                <label class="pu-chk"><input type="checkbox" id="puDetail" checked onchange="renderPuMonth()"><span>تفصيل القوائم</span></label>
                <label class="pu-chk"><input type="checkbox" id="puGroup" onchange="renderPuMonth()"><span>تجميع حسب المذخر</span></label>
            </div>
            <div class="bill-actions no-print">
                <button type="button" class="bill-tb-btn" onclick="puMonthCsv()">⬇️ Excel</button>
                <button type="button" class="bill-tb-btn bill-tb-primary" onclick="puPrint('puPane-month')">🖨️ طباعة</button>
            </div>
            <div class="no-print" id="puCloseBar"></div>
            <div class="bill-sheet" id="puMonthSheet"></div>
        </section>

        <!-- ===== سجل المردود ===== -->
        <section class="pu-pane" id="puPane-ret">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>المذخر</span><select id="lgret-sup" onchange="lgRenderRet('ret')"></select></label>
                <label class="pu-mfield"><span>الحالة</span><select id="lgret-st" onchange="lgRenderRet('ret')"><option value="">الكل</option><option value="pending">بانتظار فاتورة المردود</option><option value="done">صدرت فاتورة المردود</option><option value="nostmt">بدون كشف</option></select></label>
                <label class="pu-mfield"><span>الشهر (اختياري)</span><input type="month" id="lgret-m" oninput="lgRenderRet('ret')"></label>
                <label class="pu-mfield"><span>تنبيه بعد (يوم)</span><input type="number" id="lgret-days" min="1" oninput="lgSaveDays(this.value)"></label>
            </div>
            <div class="bill-actions no-print">
                <button type="button" class="bill-tb-btn bill-tb-primary" onclick="lgOpenReturn({})">＋ تسجيل مردود</button>
                <button type="button" class="bill-tb-btn" onclick="lgRetCsv('ret')">⬇️ Excel</button>
                <button type="button" class="bill-tb-btn" onclick="puPrint('puPane-ret')">🖨️ طباعة</button>
            </div>
            <div id="lgret-sum" class="bill-sum-card no-print"></div>
            <div id="lgret-list" class="no-print"></div>
            <div class="bill-sheet print-only" id="lgret-sheet"></div>
        </section>

        <!-- ===== المردود غير المقطوع ===== -->
        <section class="pu-pane" id="puPane-unrec">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>المذخر</span><select id="lgunrec-sup" onchange="lgRenderRet('unrec')"></select></label>
                <label class="pu-mfield"><span>السنة (اختياري)</span><input type="number" id="lgunrec-y" min="2000" max="2100" oninput="lgRenderRet('unrec')"></label>
            </div>
            <div class="bill-actions no-print">
                <button type="button" class="bill-tb-btn" onclick="lgRetCsv('unrec')">⬇️ Excel</button>
                <button type="button" class="bill-tb-btn" onclick="puPrint('puPane-unrec')">🖨️ طباعة</button>
            </div>
            <div id="lgunrec-sum" class="bill-sum-card no-print"></div>
            <div id="lgunrec-list" class="no-print"></div>
            <div class="bill-sheet print-only" id="lgunrec-sheet"></div>
        </section>

        <!-- ===== التسديد والحسابات ===== -->
        <section class="pu-pane" id="puPane-pay">
            <div class="lg-seg no-print" id="lgpSeg">
                <button type="button" data-seg="recv" onclick="lgPaySegSet('recv')">🏛️ مقبوض من الحسابات</button>
                <button type="button" data-seg="sup" onclick="lgPaySegSet('sup')">🏭 مسدَّد للمذاخر والخصم</button>
                <button type="button" data-seg="bal" onclick="lgPaySegSet('bal')">⚖️ أرصدة المذاخر</button>
            </div>
            <div class="lg-filters no-print" id="lgpFilters">
                <label class="pu-mfield"><span>الفترة</span><select id="lgpType" onchange="lgPayRender()"><option value="month">شهر</option><option value="year">سنة</option><option value="all">الكل</option></select></label>
                <label class="pu-mfield" id="lgpMW"><span>الشهر</span><input type="month" id="lgpMonth" oninput="lgPayRender()"></label>
                <label class="pu-mfield" id="lgpYW" style="display:none"><span>السنة</span><input type="number" id="lgpYear" min="2000" max="2100" oninput="lgPayRender()"></label>
                <label class="pu-mfield" id="lgpSW"><span>المذخر</span><select id="lgpSup" onchange="lgPayRender()"></select></label>
            </div>
            <div class="bill-actions no-print">
                <button type="button" class="bill-tb-btn bill-tb-primary" id="lgpAdd" onclick="lgPayAdd()">＋ إضافة</button>
                <button type="button" class="bill-tb-btn" onclick="lgPayCsv()">⬇️ Excel</button>
                <button type="button" class="bill-tb-btn" onclick="puPrint('puPane-pay')">🖨️ طباعة</button>
            </div>
            <div id="lgp-sum" class="bill-sum-card no-print"></div>
            <div id="lgp-list" class="no-print"></div>
            <div class="bill-sheet print-only" id="lgp-sheet"></div>
        </section>


        <section class="pu-pane" id="puPane-bonus">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>الفترة</span><select id="lgbType" onchange="lgRenderBonus()"><option value="month">شهر</option><option value="year">سنة</option><option value="all">الكل</option></select></label>
                <label class="pu-mfield" id="lgbMW"><span>الشهر</span><input type="month" id="lgbMonth" oninput="lgRenderBonus()"></label>
                <label class="pu-mfield" id="lgbYW" style="display:none"><span>السنة</span><input type="number" id="lgbYear" min="2000" max="2100" oninput="lgRenderBonus()"></label>
                <label class="pu-mfield"><span>المذخر</span><select id="lgbSup" onchange="lgRenderBonus()"></select></label>
            </div>
            <div class="bill-actions no-print"><button type="button" class="bill-tb-btn" onclick="lgBreqAdd()">＋ بونص من مندوب / عرض</button><button type="button" class="bill-tb-btn" onclick="lgBreqDelImported()">🗑 حذف الطلبات المستوردة</button><button type="button" class="bill-tb-btn" onclick="lgBonusCsv()">⬇️ Excel</button><button type="button" class="bill-tb-btn bill-tb-primary" onclick="puPrint('puPane-bonus')">🖨️ طباعة</button></div>
            <div id="lgb-sum" class="bill-sum-card no-print"></div>
            <div id="lgb-list" class="no-print"></div>
            <div class="bill-sheet print-only" id="lgb-sheet"></div>
        </section>

        <section class="pu-pane" id="puPane-blink">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>الحالة</span><select id="blSt" onchange="lgRenderBlink()"><option value="unlinked">غير مربوط</option><option value="linked">مربوط</option><option value="all">الكل</option></select></label>
                <label class="pu-mfield"><span>المذخر</span><select id="blSup" onchange="lgRenderBlink()"></select></label>
                <label class="pu-mfield"><span>بحث</span><input id="blQ" type="search" placeholder="اسم المادة" oninput="lgRenderBlink()"></label>
            </div>
            <div id="bl-sum" class="bill-sum-card no-print"></div>
            <div id="bl-list" class="no-print"></div>
        </section>

        <section class="pu-pane" id="puPane-unify">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>الحالة</span><select id="unSt" onchange="unLimit=200;lgRenderUnify()"><option value="todo">بحاجة لربط أو توحيد</option><option value="done">مربوطة</option><option value="all">الكل</option></select></label>
                <label class="pu-mfield"><span>بحث</span><input id="unQ" type="search" placeholder="اسم المادة أو الشركة" oninput="unLimit=200;lgRenderUnify()"></label>
            </div>
            <div id="un-sum" class="bill-sum-card no-print"></div>
            <div class="bill-actions no-print"><button type="button" class="bill-tb-btn" onclick="unSelAll()">تحديد كل المعروض</button></div>
            <div id="un-list" class="no-print"></div>
            <div id="un-bar" class="no-print un-bar" style="display:none"></div>
        </section>

        <section class="pu-pane" id="puPane-xfer">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>الفترة</span><select id="lgfType" onchange="lgRenderXfer()"><option value="month">شهر</option><option value="year">سنة</option><option value="all">الكل</option></select></label>
                <label class="pu-mfield" id="lgfMW"><span>الشهر</span><input type="month" id="lgfMonth" oninput="lgRenderXfer()"></label>
                <label class="pu-mfield" id="lgfYW" style="display:none"><span>السنة</span><input type="number" id="lgfYear" min="2000" max="2100" oninput="lgRenderXfer()"></label>
                <label class="pu-mfield lg-wide"><span>الصيدلية (اختر لفتح سجلها)</span><select id="lgxfSel" onchange="lgRenderXfer()"></select></label>
            </div>
            <div class="bill-actions no-print"><button type="button" class="bill-tb-btn bill-tb-primary" onclick="lgxOpen('xfer',{pharmacy:$b('lgxfSel').value})">＋ مناقلة</button><button type="button" class="bill-tb-btn" onclick="lgAddPharmacy()">＋ صيدلية</button><button type="button" class="bill-tb-btn" onclick="lgXpayForm()">💵 دفعة</button><button type="button" class="bill-tb-btn" onclick="lgXferCsv()">⬇️ Excel</button><button type="button" class="bill-tb-btn" onclick="puPrint('puPane-xfer')">🖨️ طباعة</button></div>
            <div id="lgxf-sum" class="bill-sum-card no-print"></div>
            <div id="lgxf-list" class="no-print"></div>
            <div class="bill-sheet print-only" id="lgxf-sheet"></div>
        </section>

        <section class="pu-pane" id="puPane-exp">
            <div class="lg-filters no-print">
                <label class="pu-mfield"><span>الفترة</span><select id="lgeType" onchange="lgRenderExp()"><option value="month">شهر</option><option value="year">سنة</option><option value="all">الكل</option></select></label>
                <label class="pu-mfield" id="lgeMW"><span>الشهر</span><input type="month" id="lgeMonth" oninput="lgRenderExp()"></label>
                <label class="pu-mfield" id="lgeYW" style="display:none"><span>السنة</span><input type="number" id="lgeYear" min="2000" max="2100" oninput="lgRenderExp()"></label>
                <label class="pu-mfield"><span>السبب</span><select id="lgeWhy" onchange="lgRenderExp()"><option value="">الكل</option><option>منتهي الصلاحية</option><option>تالف</option><option>كسر</option><option>تلف تخزين</option><option>أخرى</option></select></label>
            </div>
            <div class="bill-actions no-print"><button type="button" class="bill-tb-btn bill-tb-primary" onclick="lgxOpen('exp',{})">＋ تسجيل منتهي / تالف</button><button type="button" class="bill-tb-btn" onclick="lgExpCsv()">⬇️ Excel</button><button type="button" class="bill-tb-btn" onclick="puPrint('puPane-exp')">🖨️ طباعة</button></div>
            <div id="lge-sum" class="bill-sum-card no-print"></div>
            <div id="lge-list" class="no-print"></div>
            <div class="bill-sheet print-only" id="lge-sheet"></div>
        </section>

        <!-- ===== السجلات (الرئيسية) ===== -->
        <section class="pu-pane" id="puPane-hub"><div class="lg-hub" id="lgHub"></div></section>

        <!-- ===== الملخص المالي ===== -->
        <section class="pu-pane" id="puPane-sum">
            <div class="lg-filters no-print"><label class="pu-mfield"><span>السنة</span><input type="number" id="lgsYear" min="2000" max="2100" oninput="lgRenderSum()"></label></div>
            <div class="bill-actions no-print"><button type="button" class="bill-tb-btn" onclick="lgSumCsv()">⬇️ Excel</button><button type="button" class="bill-tb-btn bill-tb-primary" onclick="puPrint('puPane-sum')">🖨️ طباعة</button></div>
            <div class="pu-card no-print" id="lgsSet"></div>
            <div class="bill-sheet" id="lgsBody"></div>
        </section>

        <!-- ===== المذاخر والأسعار ===== -->
        <section class="pu-pane" id="puPane-sup">
            <div class="bill-panel">
                <button type="button" class="bill-tb-btn" onclick="puEditSupplier('')">＋ إضافة مذخر</button>
                <button type="button" class="bill-tb-btn" onclick="puBackfill()">🔄 تحديث المواد من سجل الوارد</button>
                <div id="puSupList2"></div>
                <h4 class="rep-h">🔎 مقارنة أسعار الشراء لدواء</h4>
                <input type="search" class="bill-list-search" id="puCmpSearch" placeholder="اكتب اسم الدواء..." oninput="puCmpInput()">
                <div class="bill-results pu-cmp-results" id="puCmpResults" style="display:none;"></div>
                <div id="puCmpBody"></div>
            </div>
        </section>
    </div>
</div>
