rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- دوال مساعدة ----
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'VrZUN6AMvTPMklvhlZcwKlqJciY2'; }
    function userPath() { return /databases/$(database)/documents/pharmacy_users/$(request.auth.uid); }
    function isStaff() { return signedIn() && exists(userPath()) && get(userPath()).data.active == true; }
    function perm(p) { return isStaff() && get(userPath()).data.perms.get(p, false) == true; }

    // ---- الأصناف العامة (يقرأها الزبائن) ----
    match /pharmacy_products/{id} {
      allow read: if true;
      allow create, delete: if isOwner() || perm('stockEdit');
      // البائع يحدّث حالة التوفر فقط (inStock) عند البيع
      allow update: if isOwner() || perm('stockEdit')
                    || (perm('sell') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inStock', '_su']))
                    // قوائم الجرد: الأسعار فقط
                    || (perm('invList') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inStock', 'price', 'pricing', 'markupPct', 'subPrice', 'subManual', 'metaUpdatedAt', '_su']));
    }
    match /pharmacy/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---- المخزون الخاص: الكميات وتواريخ الانتهاء ----
    match /pharmacy_stock/{id} {
      allow read: if isOwner() || perm('stockView') || perm('sell') || perm('invList');
      allow create, delete: if isOwner() || perm('stockEdit');
      // البائع يغيّر الكمية فقط
      allow update: if isOwner() || perm('stockEdit')
                    || (perm('sell') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'loose', '_su']))
                    // قوائم الجرد: الكميات وعلامة «مجرودة» والدفعات
                    || (perm('invList') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'loose', 'counted', 'bt', 'expiryDates', 'expiryDate', '_su']));
    }

    // ---- سجل المحذوفات للمزامنة الموفِّرة للقراءات: مستند لكل مادة محذوفة (يُنظَّف بعد 45 يوماً) ----
    // الحقل _su (ختم وقت الخادم) صار مسموحاً في تحديثات البائع وقوائم الجرد أعلاه؛ والقراءة لأي حساب مفعّل.
    match /pharmacy_tomb/{id} {
      allow read: if isOwner() || isStaff();
      allow create, update: if isOwner() || perm('stockEdit');
      allow delete: if isOwner();
    }

    // ---- قوائم الجرد ----
    match /pharmacy_counts/{id} { allow read, write: if isOwner() || perm('invList'); }

    // ---- سعر الشراء وآخر وارد: للمالك فقط ----
    match /pharmacy_cost/{id} {
      allow read: if isOwner() || perm('scanCost');   // سعر الشراء داخل فاحص المادة لمن منحه المدير الصلاحية
      allow write: if isOwner();
    }

    // ---- المصروفات (للمالك فقط) ----
    match /pharmacy_expenses/{id} {
      allow read, write: if isOwner();
    }
    // ---- المتابعات (وعود المندوبين والمواد المأخوذة) ----
    match /pharmacy_followups/{id} {
      allow read, write: if isOwner() || perm('followups');
    }
    // ---- الطلبات غير المتوفرة: أي حساب مفعّل يسجّل طلباً، والقراءة والتعديل والحذف لصاحب صلاحية المتابعات ----
    match /pharmacy_missed/{id} {
      allow create: if isOwner() || isStaff();
      allow read, update, delete: if isOwner() || perm('followups');
    }
    // ---- الفواتير ----
    match /pharmacy_invoices/{id} {
      // «فواتيره فقط» (ownInv): البائع المحدَّد لا يقرأ إلا فواتيره؛ صلاحية الزبائن تقرأ الكل لعرض الآجل
      allow read: if isOwner() || perm('customers') || (perm('sell') && (!perm('ownInv') || resource.data.byUid == request.auth.uid));
      allow create: if isOwner() || perm('sell');
      // البائع يعدّل فواتيره هو فقط، ولا يحذف
      allow update: if isOwner() || (perm('sell') && resource.data.byUid == request.auth.uid && request.resource.data.byUid == request.auth.uid)
                    // صلاحية «الزبائن»: تسديد دفعة على أي فاتورة، بتغيير المدفوع وسجل الدفعات فقط، وبإضافة دفعة لا بحذفها
                    || (perm('customers')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'payments', '_u', '_su'])
                        && request.resource.data.payments.size() > resource.data.get('payments', []).size());
      // الحذف: للمالك، أو للبائع الذي فعّل المالك له «حذف فواتيره» على فواتيره هو
      allow delete: if isOwner() || (perm('deleteOwn') && resource.data.byUid == request.auth.uid);
    }

    // ---- حركات المخزون (سجل ثابت يمنع تكرار العملية الواحدة) ----
    match /pharmacy_moves/{id} {
      allow read: if isOwner();
      allow create: if isOwner() || isStaff();
      allow update: if false;   // لا يُعدَّل سجل حركة أبداً: كتابة مؤجلة بنفس المفتاح تفشل كاملة فلا يتضاعف الخصم ولا الإضافة
      allow delete: if isOwner();
    }

    // ---- الوارد والمذاخر والسجلات المالية ----
    match /pharmacy_purchases/{id}  { allow read, write: if isOwner() || perm('purchases'); }
    match /pharmacy_suppliers/{id}  { allow read, write: if isOwner() || perm('purchases'); }
    match /pharmacy_ledger/{id}     { allow read, write: if isOwner() || perm('purchases'); }

    // ---- السلة والسجل والنسخ ----
    match /pharmacy_trash/{id}   { allow read, write: if isOwner() || perm('stockEdit'); }
    match /pharmacy_log/{id} {
      allow create: if isOwner() || isStaff();
      allow read, update, delete: if isOwner();
    }
    match /pharmacy_backups/{id} { allow read, write: if isOwner(); }

    // ---- سجل البحث الفاشل (تكتبه صفحة الزبائن): أبقِ قاعدتك الحالية إن كانت مختلفة ----
    match /pharmacy_search_misses/{id} {
      allow create, update: if true;
      allow read, delete: if isOwner();
    }

    // ---- المستخدمون ----
    match /pharmacy_users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }
    // اسم المستخدم → بريده الداخلي (قراءة مستند واحد قبل الدخول، بلا قائمة)
    match /pharmacy_logins/{login} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner();
    }
  }
}
